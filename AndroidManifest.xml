<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.rayneo.switcher"
    android:versionCode="10"
    android:versionName="0.1.9">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <permission android:name="dev.rayneo.switcher.READ_CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rayneo.switcher.READ_CONFIG" />
    <queries>
        <package android:name="com.rayneo.venus.pub" />
    </queries>
    <application
        android:label="RayNeo Switch"
        android:icon="@android:drawable/ic_menu_manage"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposeddescription" android:value="为雷鸟 AI 1.0.25 接入自定义模型回答" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SearchSettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <provider android:name=".ConfigProvider"
            android:authorities="dev.rayneo.switcher.config"
            android:readPermission="dev.rayneo.switcher.READ_CONFIG"
            android:writePermission="dev.rayneo.switcher.READ_CONFIG"
            android:grantUriPermissions="true"
            android:exported="true" />
    </application>
</manifest>
